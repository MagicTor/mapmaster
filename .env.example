# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mapmaster_dev

# Clerk Authentication (Get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Redis (Optional, for caching)
REDIS_URL=redis://localhost:6379

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3000

# Sentry (Error tracking, optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456
SENTRY_AUTH_TOKEN=sn_release_your_token

# PostHog (Analytics, optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_MULTIPLAYER=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Session
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Encryption
ENCRYPTION_KEY=your-encryption-key-min-32-chars
