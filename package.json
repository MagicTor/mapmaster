{
  "name": "mapmaster",
  "version": "1.0.0",
  "description": "A modern browser-based world geography game",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --project tsconfig.seed.json --transpile-only prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "analyze": "ANALYZE=true next build",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "^14.1.0",
    "typescript": "^5.3.3",
    "@clerk/nextjs": "^5.1.0",
    "@prisma/client": "^5.7.1",
    "zustand": "^4.4.7",
    "framer-motion": "^10.16.16",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.10.3",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "next-auth": "^4.24.10",
    "axios": "^1.6.5",
    "zod": "^3.22.4",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "date-fns": "^2.30.0",
    "lodash-es": "^4.17.21",
    "classnames": "^2.3.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/jest": "^29.5.11",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@playwright/test": "^1.40.1",
    "prisma": "^5.7.1",
    "ts-node": "^10.9.2",
    "prettier": "^3.9.5",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "@next/bundle-analyzer": "^14.1.0",
    "@sentry/cli": "^2.29.0",
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
