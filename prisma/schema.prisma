// COUNTRIES OF THE WORLD - Prisma Schema
// Simplified schema with 4 core tables

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// USERS - Basic auth + profile
// ============================================================================

model User {
  id            String   @id @default(cuid())
  username      String   @unique @db.VarChar(50)
  passwordHash  String   @db.VarChar(255)
  email         String?  @unique
  displayName   String?  @db.VarChar(100)
  avatar        String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  challengeResults ChallengeResult[]
  leaderboardCache LeaderboardCache[]

  @@index([email])
  @@map("User")
}

// ============================================================================
// COUNTRIES - Geographic data for 203 countries
// ============================================================================

model Country {
  id        String   @id @db.VarChar(2) // ISO 3166-1 alpha-2 code
  name      String   @unique @db.VarChar(100)
  capital   String   @db.VarChar(100)
  region    String   @db.VarChar(50) // North America, South America, Asia, Europe, Oceania, Africa, World
  flagUrl   String?  @db.VarChar(500)
  svgPath   String   @db.Text // SVG path for map clickability
  iso2      String   @db.VarChar(2) // ISO 3166-1 alpha-2
  iso3      String   @db.VarChar(3) // ISO 3166-1 alpha-3
  createdAt DateTime @default(now())

  @@index([region])
  @@index([name])
  @@map("Country")
}

// ============================================================================
// CHALLENGE RESULTS - Only Challenge mode completions (not Practice)
// ============================================================================

model ChallengeResult {
  id               String   @id @default(cuid())
  userId           String
  region           String   @db.VarChar(50)
  questionTypes    String   // JSON string: ["countries"] or ["countries","flags"]
  livesRemaining   Int      // 1, 2, or 3
  incorrectGuesses Int      // Total incorrect answers
  successful       Boolean  @default(false) // Only true if all countries completed
  completedAt      DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([region])
  @@index([questionTypes])
  @@index([region, questionTypes, livesRemaining, incorrectGuesses, completedAt])
  @@index([completedAt])
  @@map("ChallengeResult")
}

// ============================================================================
// LEADERBOARD CACHE - Pre-calculated rankings for fast queries (optional)
// ============================================================================

model LeaderboardCache {
  id               String   @id @default(cuid())
  region           String   @db.VarChar(50)
  questionTypes    String   @db.VarChar(50)
  month            Int      // 1-12
  year             Int      // e.g., 2026
  rank             Int      // 1, 2, 3, etc.
  userId           String
  livesRemaining   Int
  incorrectGuesses Int
  completedAt      DateTime
  totalPlayers     Int
  lastUpdated      DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([region, questionTypes, month, year, rank])
  @@index([userId, region, questionTypes, month, year])
  @@map("LeaderboardCache")
}
